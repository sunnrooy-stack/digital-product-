# Backend Server Port
PORT=5000

# MongoDB Database Connection String (Prisma)
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/digital_store?retryWrites=true&w=majority"

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Render Production URL for Keep-Alive and CORS
RENDER_EXTERNAL_URL=https://digital-product-1-l3qr.onrender.com
BACKEND_URL=http://localhost:5000

# Redis Cache URL (Optional)
REDIS_URL=redis://localhost:6379

# Firebase Admin SDK Credentials (Optional)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
